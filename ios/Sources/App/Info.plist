<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Zen</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The commit this build was made from (#008B6); "dev" outside the
	     orchestrator's signed-build step. Read from Settings > About so a
	     phone install can be told apart from the last one. -->
	<key>ZenGitCommit</key>
	<string>$(ZEN_GIT_COMMIT)</string>
	<!-- Video and audio keep playing when the app is backgrounded or the
	     phone is locked, and Picture in Picture needs it too (#008B0). The
	     audio session itself is only claimed once a page actually starts
	     playing something — see MediaSession. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Hidden from the very first frame, so a default launch never flashes a
	     status bar that the app is about to remove. This key only governs the
	     launch; once the scene is up, RootView's `.statusBarHidden` (i.e. the
	     hosting controller's `prefersStatusBarHidden`) is authoritative, which
	     is why `UIViewControllerBasedStatusBarAppearance` is deliberately left
	     at its YES default — setting it to NO would take the toggle away. -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- A browser has to be able to load whatever the owner types, including
		     the plain-HTTP admin pages homelab boxes still serve. Scoped to web
		     content so the app's own URLSession traffic (favicons, search
		     suggestions) still gets ATS. -->
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<!-- Required for .lan / .local / RFC1918 destinations alongside the
		     local-network permission prompt below. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Zen needs local network access to open sites hosted on devices in your home, such as a router admin page or a home server, and to find them when you scan from Settings.</string>
	<!-- iOS only lets an app browse the Bonjour types it declares here, so this
	     list and LANScanController.bonjourTypes have to stay in step. These are
	     the types a home network actually advertises: web and admin panels,
	     shells and file transfer, file and print sharing, and the media and
	     automation devices that announce themselves. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
		<string>_ssh._tcp</string>
		<string>_sftp-ssh._tcp</string>
		<string>_smb._tcp</string>
		<string>_printer._tcp</string>
		<string>_ipp._tcp</string>
		<string>_airplay._tcp</string>
		<string>_homekit._tcp</string>
		<string>_hap._tcp</string>
		<string>_googlecast._tcp</string>
		<string>_workstation._tcp</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
